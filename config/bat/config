# bat configuration file
# Each line is a command-line option passed to bat by default.
# Run `bat --help` for all options.

# Theme (run `bat --list-themes` to see all)
--theme="Dracula"

# Enable italic text (not supported on all terminals)
--italic-text=always

# Syntax mappings
--map-syntax "zshrc:Bourne Again Shell (bash)"
--map-syntax "zshenv:Bourne Again Shell (bash)"
--map-syntax "Brewfile:Bourne Again Shell (bash)"